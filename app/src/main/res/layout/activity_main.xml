<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_gradient" android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="KHAN AI" android:textColor="@color/text"
            android:textStyle="bold" android:textSize="26sp"/>
        <TextView android:id="@+id/status" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="● Ready"
            android:textColor="#A8FFB0" android:textSize="13sp"/>
    </LinearLayout>

    <TextView android:id="@+id/hero" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:text="Hi, I'm Khan 👋\nYour personal AI assistant"
        android:textColor="@color/text" android:textSize="29sp" android:textStyle="bold"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:text="Ask, speak, create and get things done."
        android:textColor="@color/muted" android:textSize="15sp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:orientation="horizontal">
        <Button android:id="@+id/voiceBtn" android:layout_width="0dp" android:layout_height="54dp"
            android:layout_weight="1" android:text="🎙  Voice" android:textColor="@color/text"
            android:background="@drawable/button_bg"/>
        <Space android:layout_width="10dp" android:layout_height="1dp"/>
        <Button android:id="@+id/settingsBtn" android:layout_width="0dp" android:layout_height="54dp"
            android:layout_weight="1" android:text="⚙  API Key" android:textColor="@color/text"
            android:background="@drawable/card_bg"/>
    </LinearLayout>

    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp">
        <LinearLayout android:id="@+id/chat" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:layout_marginTop="10dp">
        <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:hint="Message Khan..." android:paddingStart="18dp"
            android:paddingEnd="18dp" android:textColor="@color/text" android:textColorHint="@color/muted"
            android:background="@drawable/card_bg"/>
        <Space android:layout_width="8dp" android:layout_height="1dp"/>
        <Button android:id="@+id/sendBtn" android:layout_width="70dp" android:layout_height="56dp"
            android:text="➤" android:textSize="20sp" android:textColor="@color/text"
            android:background="@drawable/button_bg"/>
    </LinearLayout>
</LinearLayout>
